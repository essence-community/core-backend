{
    "name": "ungate",
    "version": "3.1.0",
    "description": "Шлюз",
    "private": true,
    "engines": {
        "yarn": ">=1.22.0",
        "node": ">=22.0.0"
    },
    "scripts": {
        "prettier:fix": "prettier --write \"{,!(node_modules|dist|build|bin|libs|coverage)/**/}*.{js,jsx,ts,tsx,json}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "build": "gulp all",
        "clear": "rimraf bin",
        "pre-commit": "yarn prettier && yarn build"
    },
    "husky": {
        "hooks": {
            "pre-commit": "yarn pre-commit"
        }
    },
    "author": "Ivan Artemov (honyrik@gmail.com)",
    "license": "MIT",
    "workspaces": [
        "server",
        "plugininf",
        "contexts/*",
        "plugins/*",
        "providers/*",
        "schedulers/*",
        "events/*",
        "libs/*"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/async": "^3.2.26",
        "@types/bcrypt-nodejs": "0.0.31",
        "@types/body-parser": "^1.19.6",
        "@types/commander": "^2.12.2",
        "@types/compression": "1.8.1",
        "@types/cpy": "^7.1.3",
        "@types/dotenv": "^8.2.0",
        "@types/errorhandler": "1.5.3",
        "@types/es6-shim": "^0.31.46",
        "@types/gulp": "^4.0.18",
        "@types/http-server": "^0.12.1",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.25",
        "@types/node": "^22.20.3",
        "@types/rimraf": "^4.0.5",
        "@typescript/native": "npm:typescript@^7.0.2",
        "commander": "^15.0.0",
        "cpy": "^13.2.3",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "gulp": "^5.0.1",
        "gulp-typescript": "^6.0.0-alpha.1",
        "husky": "^9.1.7",
        "prettier": "^3.9.7",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.4.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "resolutions": {
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "axios": "1.20.0",
        "async": "3.2.6",
        "es5-ext": "0.10.64",
        "underscore": "1.13.8"
    }
}
